# Envio de correos: elegir SMTP o Gmail OAuth (completar uno u otro, pero no ambos)
#
# --- Opción 1: SMTP normal (recomendado) ---
# SMTP_SERVER=mail.example.com
# SMTP_PORT=587
# SMTP_USER=alertas@example.com
# SMTP_PASSWORD=contraseña-segura
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# EMAIL_FROM=alertas@example.com
# EMAIL_FROM_NAME=Inteligencia de Amenazas
# EMAIL_REPLY_TO=
#
# --- Opción 2: Gmail API (OAuth2) ---
# Para usar Gmail, se necesita:
# 1. Crear un proyecto en Google Cloud Console (https://console.cloud.google.com)
# 2. Habilitar Gmail API
# 3. Crear credenciales OAuth2 (tipo: aplicación de escritorio)
# 4. Realizar el flujo OAuth2 (una sola vez) para obtener refresh_token
#    Usar: https://developers.google.com/oauthplayground
#    Seleccionar Gmail API v1 → https://www.googleapis.com/auth/gmail.send
#    Autorizar y obtener el refresh_token
#
# GMAIL_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=xxxxx
# GMAIL_REFRESH_TOKEN=xxxxx
#
# Destinatarios de las alertas diarias
ALERT_EMAIL_TO=admin@example.com
ALERT_EMAIL_CC=

# Destinatarios del informe mensual (si está vacío, igual que ALERT_EMAIL_TO)
REPORT_EMAIL_TO=
REPORT_EMAIL_CC=

# Destinatarios de los avisos de administración
ADMIN_EMAIL=admin@example.com

# OCS Inventory (solo lectura): un bloque por servidor de inventario
OCS_SERVIDORES_HOST=192.0.2.10
OCS_SERVIDORES_PORT=3306
OCS_SERVIDORES_DB=ocsweb
OCS_SERVIDORES_USER=
OCS_SERVIDORES_PASSWORD=
OCS_EQUIPOS_HOST=192.0.2.20
OCS_EQUIPOS_PORT=3306
OCS_EQUIPOS_DB=ocsweb
OCS_EQUIPOS_USER=
OCS_EQUIPOS_PASSWORD=
